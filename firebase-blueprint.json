{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated ClipFlow AI user profile, plan tier, usage metrics, and Brand Kit configuration.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the user." },
        "displayName": { "type": "string", "description": "Display name of the creator." },
        "email": { "type": "string", "description": "Email address of the user." },
        "planTier": { "type": "string", "enum": ["FREE", "PRO", "PREMIUM"], "description": "Active subscription tier." },
        "clipsGeneratedCount": { "type": "integer", "description": "Total viral clips generated." },
        "brandName": { "type": "string", "description": "Creator or channel Brand Kit watermark name." },
        "brandPrimaryHex": { "type": "string", "description": "Brand Kit primary highlight hex color." },
        "brandFontStyle": { "type": "string", "description": "Brand Kit preferred typography style." },
        "brandIntroTag": { "type": "string", "description": "Optional intro tag line for clips." },
        "brandOutroTag": { "type": "string", "description": "Optional outro call-to-action tag." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of profile creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update." }
      },
      "required": [
        "userId",
        "displayName",
        "planTier",
        "clipsGeneratedCount",
        "brandName",
        "brandPrimaryHex",
        "brandFontStyle",
        "createdAt",
        "updatedAt"
      ]
    },
    "VideoProject": {
      "title": "VideoProject",
      "description": "A ClipFlow AI video clipping project with source metadata, AI transcript, and generation settings.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "title": { "type": "string", "description": "Project title." },
        "folderName": { "type": "string", "description": "Project organization folder." },
        "sourceType": { "type": "string", "enum": ["LOCAL_VIDEO", "YOUTUBE_URL", "DIRECT_URL"], "description": "Video source origin." },
        "sourceUrl": { "type": "string", "description": "Authorized URI or URL of source video." },
        "thumbnailUrl": { "type": "string", "description": "Preview thumbnail URL if remote." },
        "videoCategory": { "type": "string", "description": "Content category such as Podcast, Educational, Vlog." },
        "status": { "type": "string", "enum": ["ANALYZED", "RENDERING", "COMPLETED", "FAILED"], "description": "Current pipeline state." },
        "durationMs": { "type": "integer", "description": "Source video duration in milliseconds." },
        "transcriptText": { "type": "string", "description": "Full or sampled AI transcript." },
        "aiSummary": { "type": "string", "description": "AI overview of key topics and moments." },
        "copilotInstruction": { "type": "string", "description": "Custom AI Viral Clipping Copilot instruction." },
        "aspectRatio": { "type": "string", "enum": ["9:16", "16:9", "1:1", "4:5"], "description": "Target export aspect ratio." },
        "captionStyle": { "type": "string", "description": "Selected caption style template." },
        "captionLanguage": { "type": "string", "description": "Selected caption language." },
        "clipCountRequested": { "type": "integer", "description": "Number of clips requested." },
        "durationPreset": { "type": "string", "description": "Target duration range preset." },
        "intensityPreset": { "type": "string", "description": "Clipping intensity strategy." },
        "voiceEnhanceEnabled": { "type": "boolean", "description": "AI voice enhancement toggle." },
        "noiseReductionEnabled": { "type": "boolean", "description": "Background noise reduction toggle." },
        "musicEnabled": { "type": "boolean", "description": "Background music toggle." },
        "sfxEnabled": { "type": "boolean", "description": "Context-aware sound effects toggle." },
        "silenceRemovalEnabled": { "type": "boolean", "description": "Auto silence removal toggle." },
        "faceTrackingEnabled": { "type": "boolean", "description": "Smart face tracking reframing toggle." },
        "speakerLayout": { "type": "string", "description": "Multi-speaker framing layout." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update." }
      },
      "required": [
        "userId",
        "title",
        "folderName",
        "sourceType",
        "sourceUrl",
        "videoCategory",
        "status",
        "durationMs",
        "transcriptText",
        "aiSummary",
        "aspectRatio",
        "captionStyle",
        "captionLanguage",
        "clipCountRequested",
        "durationPreset",
        "intensityPreset",
        "voiceEnhanceEnabled",
        "noiseReductionEnabled",
        "musicEnabled",
        "sfxEnabled",
        "silenceRemovalEnabled",
        "faceTrackingEnabled",
        "speakerLayout",
        "createdAt",
        "updatedAt"
      ]
    },
    "GeneratedClip": {
      "title": "GeneratedClip",
      "description": "A generated viral short clip candidate with timestamps, AI score, hooks, captions, and export state.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "projectId": { "type": "string", "description": "Parent VideoProject document ID." },
        "clipIndex": { "type": "integer", "description": "1-based rank index of clip." },
        "title": { "type": "string", "description": "AI-generated engaging clip title." },
        "hook": { "type": "string", "description": "Selected opening hook text." },
        "hookType": { "type": "string", "description": "Hook category such as Curiosity or Question." },
        "hookOptions": { "type": "array", "description": "Alternative AI hook suggestions." },
        "startMs": { "type": "integer", "description": "Clip start timestamp in milliseconds." },
        "endMs": { "type": "integer", "description": "Clip end timestamp in milliseconds." },
        "viralScore": { "type": "integer", "description": "AI Viral Potential Score from 0 to 100." },
        "scoreReason": { "type": "string", "description": "AI explanation of why this moment was selected." },
        "transcriptExcerpt": { "type": "string", "description": "Segment transcript excerpt." },
        "captionsText": { "type": "string", "description": "Original language synced captions text." },
        "translatedCaptionsText": { "type": "string", "description": "Translated captions text if multilingual." },
        "captionLanguage": { "type": "string", "description": "Target caption language." },
        "captionStyle": { "type": "string", "description": "Caption visual template name." },
        "captionColorHex": { "type": "string", "description": "Caption highlight hex color." },
        "captionPositionY": { "type": "number", "description": "Normalized vertical caption placement (0.1 to 0.95)." },
        "aspectRatio": { "type": "string", "enum": ["9:16", "16:9", "1:1", "4:5"], "description": "Clip aspect ratio." },
        "faceFocusX": { "type": "number", "description": "Normalized horizontal face focus center (0.0 to 1.0)." },
        "platformPreset": { "type": "string", "description": "Export platform preset (YouTube Shorts, Instagram Reels, TikTok)." },
        "youtubeTitle": { "type": "string", "description": "YouTube Shorts title." },
        "instagramCaption": { "type": "string", "description": "Instagram Reels caption." },
        "tiktokDescription": { "type": "string", "description": "TikTok description." },
        "hashtags": { "type": "string", "description": "Recommended hashtags." },
        "qualityHook": { "type": "integer", "description": "Hook quality sub-score 0..100." },
        "qualityCaption": { "type": "integer", "description": "Caption accuracy sub-score 0..100." },
        "qualityAudio": { "type": "integer", "description": "Audio quality sub-score 0..100." },
        "qualityFraming": { "type": "integer", "description": "Visual framing sub-score 0..100." },
        "qualityContext": { "type": "integer", "description": "Context completeness sub-score 0..100." },
        "localFilePath": { "type": "string", "description": "On-device path to rendered MP4 file." },
        "gallerySaved": { "type": "boolean", "description": "Whether MediaStore confirmed saving to gallery." },
        "rendered": { "type": "boolean", "description": "Whether local MP4 export completed." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update." }
      },
      "required": [
        "userId",
        "projectId",
        "clipIndex",
        "title",
        "hook",
        "hookType",
        "hookOptions",
        "startMs",
        "endMs",
        "viralScore",
        "scoreReason",
        "transcriptExcerpt",
        "captionsText",
        "captionLanguage",
        "captionStyle",
        "captionColorHex",
        "captionPositionY",
        "aspectRatio",
        "faceFocusX",
        "platformPreset",
        "qualityHook",
        "qualityCaption",
        "qualityAudio",
        "qualityFraming",
        "qualityContext",
        "gallerySaved",
        "rendered",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClipTemplate": {
      "title": "ClipTemplate",
      "description": "Saved custom visual & caption template preset.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner Firebase Auth UID." },
        "name": { "type": "string", "description": "Template preset name." },
        "aspectRatio": { "type": "string", "enum": ["9:16", "16:9", "1:1", "4:5"], "description": "Aspect ratio." },
        "captionStyle": { "type": "string", "description": "Caption template name." },
        "captionColorHex": { "type": "string", "description": "Caption highlight hex color." },
        "captionLanguage": { "type": "string", "description": "Caption language." },
        "platformPreset": { "type": "string", "description": "Target social platform." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last update." }
      },
      "required": [
        "userId",
        "name",
        "aspectRatio",
        "captionStyle",
        "captionColorHex",
        "captionLanguage",
        "platformPreset",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile, subscription plan, and Brand Kit settings."
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/VideoProject" },
      "description": "User-owned video clipping projects."
    },
    "/users/{userId}/projects/{projectId}/clips/{clipId}": {
      "schema": { "$ref": "#/entities/GeneratedClip" },
      "description": "Generated viral short clips for a project."
    },
    "/users/{userId}/templates/{templateId}": {
      "schema": { "$ref": "#/entities/ClipTemplate" },
      "description": "Saved user clip and caption templates."
    }
  }
}
